AWS_REGION=us-east-1
OUTBOX_TABLE=pedidos360-outbox-prod
ANALYTICS_TABLE=pedidos360-analytics-prod

# Public Elastic IP or stable DNS name of the broker.
KAFKA_BROKERS=__KAFKA_ELASTIC_IP__:9092
KAFKA_ADVERTISED_HOST=__KAFKA_ELASTIC_IP__
KAFKA_TOPIC=orders.events
KAFKA_ANALYTICS_GROUP=analytics-service
KAFKA_TLS=true
KAFKA_CA_PATH=/etc/kafka/secrets/ca.crt
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=CHANGE_ME
KAFKA_SASL_PASSWORD=CHANGE_ME

# Mount this directory outside Git:
# infra/kafka/secrets/
